# i3status configuration file.
# see "man i3status" for documentation.

general {
    colors = true
    interval = 5
    color_good = "#c5c8c6"
    color_degraded = "#f0c674"
    color_bad = "#cc6666"
    output_format = "i3bar"
    separator = false
}

order += "wireless _first_"
order += "ethernet _first_"
order += "disk /"
order += "memory"
order += "cpu_usage"
order += "battery all"
order += "volume master"
order += "read_file audio"
order += "read_file mic"
order += "read_file weather"
order += "tztime local"

wireless _first_ {
    format_up = "W: %essid %quality"
    format_down = ""
}

ethernet _first_ {
    format_up = "E: %ip"
    format_down = ""
}

disk "/" {
    format = "Disk: %avail"
}

memory {
    format = "Mem: %used/%available"
    threshold_degraded = "1G"
    format_degraded = "Mem: < %available"
}

cpu_usage {
    format = "CPU: %usage"
}

battery all {
    format = "%status %percentage %remaining"
    format_down = ""
    status_chr = "CHR"
    status_bat = "BAT"
    status_full = "FULL"
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 15
}

volume master {
    format = "Vol: %volume"
    format_muted = "Vol: muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

read_file weather {
    path = "/tmp/weather.txt"
    format = "%content"
}

read_file audio {
    path = "/tmp/audio_output.txt"
    format = "%content"
}

read_file mic {
    path = "/tmp/mic_status.txt"
    format = "%content"
}

tztime local {
    format = "%m-%d %a %I:%M %p"
    timezone = "America/Toronto"
}
